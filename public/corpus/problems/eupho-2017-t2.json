                  {
                    "type": "text",
                    "text": "Disk in gas"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "text",
        "text": "\n"
      },
      {
        "type": "element",
        "tag": "p",
        "children": [
          {
            "type": "text",
            "text": "Consider a thin flat disk of mass "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(M\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": " and face area "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(S\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": " at temperature "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(T_1\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": " resting initially in weightlessness in a gas of mass density "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(\\rho\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": " at temperature "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(T_0\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": " ("
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(T_1 = 1000\\ T_0\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": "). One of the faces of the disk is covered with a thermally insulating layer, the other face has a very good thermal contact with the surrounding gas: gas molecules of mass "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(m\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": " obtain the temperature of the disk during a single collision with the surface. Estimate the initial acceleration "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(a_0\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": " and maximal speed "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(v_{max}\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": " of the disk during its subsequent motion. Assume the heat capacity of the disk to be on the of order "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(Nk_B\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": ", where "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(N\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": " is the number of atoms in it, and "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(k_B\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": " is the Boltzmann constant, and molar masses of the gas and the disk’s material to be of the same order. The mean free path length of molecules is much larger than the size of the disk. Neglect any edge effects occuring at the edge of the disk."
          }
        ]
      },
      {
        "type": "text",
        "text": "\n"
      }
    ],
    "text": "Disk in gas\n\n\nConsider a thin flat disk of mass \n\\(M\\)\n and face area \n\\(S\\)\n at temperature \n\\(T_1\\)\n resting initially in weightlessness in a gas of mass density \n\\(\\rho\\)\n at temperature \n\\(T_0\\)\n (\n\\(T_1 = 1000\\ T_0\\)\n). One of the faces of the disk is covered with a thermally insulating layer, the other face has a very good thermal contact with the surrounding gas: gas molecules of mass \n\\(m\\)\n obtain the temperature of the disk during a single collision with the surface. Estimate the initial acceleration \n\\(a_0\\)\n and maximal speed \n\\(v_{max}\\)\n of the disk during its subsequent motion. Assume the heat capacity of the disk to be on the of order \n\\(Nk_B\\)\n, where \n\\(N\\)\n is the number of atoms in it, and \n\\(k_B\\)\n is the Boltzmann constant, and molar masses of the gas and the disk’s material to be of the same order. The mean free path length of molecules is much larger than the size of the disk. Neglect any edge effects occuring at the edge of the disk.\n\n",
    "figures": [],
    "shared": false
  },
  "solution": {
    "format": "html",
    "referencePdf": "/corpus/documents/eupho-2017-solution/document.pdf",
    "nodes": [
      {
        "type": "element",
        "tag": "p",
        "children": [
          {
            "type": "element",
            "tag": "strong",
            "children": [
              {
                "type": "text",
                "text": "Solution - Disk in gas"
              }
            ]
          }
        ]
      },
      {
        "type": "text",
        "text": "\n"
      },
      {
        "type": "element",
        "tag": "p",
        "children": [
          {
            "type": "text",
            "text": "The initial pressure on the thermal insulating layer is "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(P_0 = nk_BT_0\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": ", where "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(n\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": " is number density of the gas. It originates from multiplying the flux "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(j_0 \\propto v_{x0}\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": " and momentum that one molecule transfers "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(p_0 = 2mv_{x0}\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": " (elastic collision), where "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(v_{x0}\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": " is the normal component of molecule’s velocity, and taking the average "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\((\\overline{2v_{x0}^2} \\propto T_0)\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": ". When applying the same idea to the surface with good thermal contact, we find out that the flux remains the same, although the momentum increases: "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\[p_1 = m(v_{x0} + v_{x1}) \\approx mv_{x1},\\]"
              }
            ]
          },
          {
            "type": "text",
            "text": " where "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(v_{x1}\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": " is the normal velocity component of the molecule flying away from the disk. Thus for pressure "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(P_1\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": ": "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\[\\frac{P_1}{P_0} = \\frac{\\overline{v_{x0}v_{x1}}}{\\overline{2v_{x0}^2}} \\approx \\frac{\\sqrt{T_1T_0}}{T_0},\\]"
              }
            ]
          },
          {
            "type": "text",
            "text": " which is correct to some numerical coefficient of the order of one."
          }
        ]
      },
      {
        "type": "text",
        "text": "\n"
      },
      {
        "type": "element",
        "tag": "p",
        "children": [
          {
            "type": "text",
            "text": "The net force acting on the disk: "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\[F = (P_1 - P_0)S \\approx Snk_B\\sqrt{T_0T_1},\\]"
              }
            ]
          },
          {
            "type": "text",
            "text": " and then the initial acceleration: "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\[a_0 \\approx \\frac{Snk_B}{M}\\sqrt{T_0T_1} = \\frac{S\\rho k_B}{mM}\\sqrt{T_0T_1}.\\]"
              }
            ]
          }
        ]
      },
      {
        "type": "text",
        "text": "\n"
      },
      {
        "type": "element",
        "tag": "p",
        "children": [
          {
            "type": "text",
            "text": "Since "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(P_1 \\gg P_0\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": ", the disk will accelerate until its speed becomes of the order of average gas molecules speed. After the velocity "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(v\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": " of the disc becomes on the order of "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(v_0 = \\sqrt{k_BT_0/m}\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": ", the flux of molecules reaching the backside "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(j(v)\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": " decays faster than exponentially due to the nature of the molecular velocity distribution in the ideal gas (for example, "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(j(2v_0) \\approx 10^{-3}j_0\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": " and "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(j(3v_0) \\approx 10^{-6}j_0\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": "). That leads to a proportional decrease in a propelling pressure "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(P_1\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": ". In order to compensate for an initial bias "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(\\sqrt{T_1/T_0} \\approx 30\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": ", it will take around a factor of one on the velocity of the disk. Therefore the maximum velocity of the disk: "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\[v_\\mathrm{max} \\approx v_0 = \\sqrt{\\frac{k_BT_0}{m}}.\\]"
              }
            ]
          }
        ]
      },
      {
        "type": "text",
        "text": "\n"
      },
      {
        "type": "element",
        "tag": "p",
        "children": [
          {
            "type": "text",
            "text": "Here we assumed that the disk will not cool close to "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(T_0\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": " before it reaches the maximum velocity. Let us show it. The acceleration time is approximately: "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\[t_a \\approx \\frac{v_\\mathrm{max}}{a_0} \\approx \\frac{M\\sqrt{mk_BT_O}}{S\\rho k_B\\sqrt{T_0T_1}} = \\frac{M}{\\rho S}\\sqrt{\\frac{m}{k_BT_1}}\\]"
              }
            ]
          }
        ]
      },
      {
        "type": "text",
        "text": "\n"
      },
      {
        "type": "element",
        "tag": "p",
        "children": [
          {
            "type": "text",
            "text": "Since the power of heat removal "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(P_{th}\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": " is maximal at the beginning (at zero velocity), we can upper-bound estimate the time for the disk to cool as "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(t_c = Q/P_{th}\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": ", where "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(Q\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": " is the total heat of the disk. The initial thermal power of heat removal can be estimated as: "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\[P_{th} \\approx Sj_0 \\times k_BT_1 \\approx Snk_B\\sqrt{T_0T_1}\\sqrt{\\frac{k_BT_1}{m}}\\]"
              }
            ]
          },
          {
            "type": "text",
            "text": " and the total heat "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(Q \\approx Nk_BT_1\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": ". Given "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(M \\approx Nm\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": ", we obtain: "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\[t_c \\approx \\frac{(M/m)k_BT_1}{Snk_BT_1\\sqrt{k_BT_0/m}} = \\frac{M}{\\rho S}\\sqrt{\\frac{m}{k_BT_0}}\\]"
              }
            ]
          },
          {
            "type": "text",
            "text": " Finally, "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(t_a/t_c \\approx \\sqrt{T_0/T_1} \\ll 1\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": ", and indeed disk will not cool significantly before it reaches the velocity about "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(v_0\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": "."
          }
        ]
      },
      {
        "type": "text",
        "text": "\n"
      },
      {
        "type": "element",
        "tag": "p",
        "children": [
          {
            "type": "element",
            "tag": "em",
            "children": [
              {
                "type": "text",
                "text": "Grading scheme. Indented lines show partial points for partially correct solutions"
              }
            ]
          }
        ]
      },
      {
        "type": "text",
        "text": "\n"
      },
      {
        "type": "element",
        "tag": "p",
        "children": [
          {
            "type": "element",
            "tag": "strong",
            "children": [
              {
                "type": "text",
                "text": "Initial acceleration (5 pts)"
              }
            ]
          }
        ]
      },
      {
        "type": "text",
        "text": "\n"
      },
      {
        "type": "element",
        "tag": "p",
        "children": [
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(P_0 = nkT = j_0 \\times \\Delta p_0\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": ", "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(\\Delta p_0 = 2mv_{x0}\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "element",
            "tag": "strong",
            "children": [
              {
                "type": "text",
                "text": "2 pts"
              }
            ]
          }
        ]
      },
      {
        "type": "text",
        "text": "\n"
      },
      {
        "type": "element",
        "tag": "p",
        "children": [
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(P \\propto kT\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": "  pts"
          }
        ]
      },
      {
        "type": "text",
        "text": "\n"
      },
      {
        "type": "element",
        "tag": "p",
        "children": [
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(\\Delta p_1 = mv_{x1}\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": ", "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(P_1 \\approx nk\\sqrt{T_0T_1}\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "element",
            "tag": "strong",
            "children": [
              {
                "type": "text",
                "text": "2 pts"
              }
            ]
          }
        ]
      },
      {
        "type": "text",
        "text": "\n"
      },
      {
        "type": "element",
        "tag": "p",
        "children": [
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(P_1 = nkT_1\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": ", no points for "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(a_0\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": " further  pts"
          }
        ]
      },
      {
        "type": "text",
        "text": "\n"
      },
      {
        "type": "element",
        "tag": "p",
        "children": [
          {
            "type": "text",
            "text": "only "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(\\Delta p_1 = mv_{x1}\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": "  pts"
          }
        ]
      },
      {
        "type": "text",
        "text": "\n"
      },
      {
        "type": "element",
        "tag": "p",
        "children": [
          {
            "type": "text",
            "text": "Answer for "
          },
          {
            "type": "element",
            "tag": "span",
            "children": [
              {
                "type": "text",
                "text": "\\(a_0\\)"
              }
            ]
          },
          {
            "type": "text",
            "text": " "
          },
          {
            "type": "element",
            "tag": "strong",
            "children": [
              {
                "type": "text",
                "text": "1 pts"
              }
            ]
          }
        ]
      },
      {
        "type": "text",
        "text": "\n"
      },
      {
        "type": "element",
        "tag": "p",
        "children": [
          {
