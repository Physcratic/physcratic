+  ...(sourceCase && {databaseOid:Number(databaseOid), targetRevision, tallyReferences:[], sourceAuthorization:{
+    caseId:sourceCase, intentSha256, outcome:scenario==='confirmed' ? 'receipt-confirmed' : scenario,
+  }}),
