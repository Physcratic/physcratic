+ SELECT coalesce(jsonb_agg(jsonb_build_object('problemId',p.id,'revisionId',p.published_revision_id,
+        'digest',encode(sha256(convert_to(jsonb_build_array(r.rights_basis,r.review_reference)::text,'UTF8')),'hex'))
+        ORDER BY p.id),'[]')
