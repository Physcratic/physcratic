+  source_db -c "SELECT account_deletion_execute('synthetic-restore-a','synthetic-source-only','NONFUNCTIONAL-HASH',repeat('d',64))" | grep -q 'database-erased-cleanup-pending'
+elif [[ "$scenario" == execution-unknown ]]; then
