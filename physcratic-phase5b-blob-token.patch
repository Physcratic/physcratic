+  EXECUTE definition;
+  REVOKE ALL ON FUNCTION pg_temp.restore_erasure_execute(text,text) FROM PUBLIC;
+  outcome := pg_temp.restore_erasure_execute(subject, approval_nonce);
+  DROP FUNCTION pg_temp.restore_erasure_execute(text,text);
