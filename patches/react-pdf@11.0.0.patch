+// Recover only two malformed tag patterns without dropping content or inventing cells.
+export function normalizeStructTreeNode(node) {
+    if (!isStructTreeNode(node)) return node;
+    const bare = (value) => Object.keys(value).every((key) => key === 'role' || key === 'children');
+    if (node.role === 'L' && bare(node) && node.children.length === 1 &&
+        isStructTreeNode(node.children[0]) && node.children[0].role === 'L') {
+        return normalizeStructTreeNode(node.children[0]);
+    }
+    if (node.role !== 'TR') return node;
+    const index = node.children.findLastIndex((child) =>
+        isStructTreeNode(child) && (child.role === 'TD' || child.role === 'TH'));
+    const trailing = node.children.slice(index + 1);
+    if (index < 0 || trailing.length === 0 || !node.children.slice(0, index).every((child) =>
+        isStructTreeNode(child) && (child.role === 'TD' || child.role === 'TH')) || !trailing.every((child) =>
+        isStructTreeNode(child) && child.role === 'Span' && bare(child) &&
+        child.children.every((leaf) => !isStructTreeNode(leaf) && leaf.type === 'content'))) return node;
+    const cell = node.children[index];
+    return { ...node, children: [...node.children.slice(0, index),
+        { ...cell, children: [...cell.children, ...trailing] }] };
+}
